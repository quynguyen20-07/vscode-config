{
  "name": "vscode-config-cli",
  "version": "1.0.0",
  "description": "CLI helper for vscode-config: install fonts and manage VS Code profiles",
  "preferGlobal": true,
  "bin": {
    "vscode-config": "bin/cli.js"
  },
