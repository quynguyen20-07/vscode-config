{
  "name": "🦅 NestJS Pro",
  "settings": "{\"settings\":\"{\\n  // --- UI & WebStorm Experience ---\\n  \\\"workbench.colorTheme\\\": \\\"Catppuccin Macchiato\\\",\\n  \\\"workbench.iconTheme\\\": \\\"material-icon-theme\\\",\\n  \\\"editor.fontFamily\\\": \\\"'JetBrains Mono', Consolas, 'Courier New', monospace\\\",\\n  \\\"editor.fontSize\\\": 14,\\n  \\\"editor.lineHeight\\\": 22,\\n  \\\"editor.fontLigatures\\\": true,\\n  \\\"editor.cursorBlinking\\\": \\\"smooth\\\",\\n  \\\"editor.cursorSmoothCaretAnimation\\\": \\\"on\\\",\\n  \\\"editor.smoothScrolling\\\": true,\\n  \\\"workbench.list.smoothScrolling\\\": true,\\n  \\\"editor.minimap.enabled\\\": false,\\n  \\\"editor.guides.bracketPairs\\\": \\\"active\\\",\\n\\n  // --- Sidebar, Menu --- JetBrains Mono ---\\n  \\\"vscode_custom_css.imports\\\": [\\\"file:///D:/VSCode/ui-font.css\\\"],\\n  \\\"vscode_custom_css.policy\\\": true,\\n\\n  // --- Anti-Lag & Backend Optimization ---\\n  \\\"files.watcherExclude\\\": {\\n    \\\"**/.git/objects/**\\\": true,\\n    \\\"**/node_modules/**\\\": true,\\n    \\\"**/dist/**\\\": true,\\n    \\\"**/coverage/**\\\": true,\\n  },\\n  \\\"js/ts.tsc.autoDetect\\\": \\\"off\\\",\\n  \\\"js/ts.suggest.completeFunctionCalls\\\": true,\\n  \\\"js/ts.updateImportsOnFileMove.enabled\\\": \\\"always\\\",\\n  \\\"js/ts.implicitProjectConfig.experimentalDecorators\\\": true,\\n\\n  // --- Auto Format & Linting ---\\n  \\\"editor.formatOnSave\\\": true,\\n  \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n  \\\"editor.codeActionsOnSave\\\": {\\n    \\\"source.fixAll.eslint\\\": \\\"explicit\\\",\\n    \\\"source.organizeImports\\\": \\\"explicit\\\",\\n  },\\n  \\\"[typescript]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n  },\\n\\n  // --- Developer Tools (REST Client, Docker) ---\\n  \\\"rest-client.fontFamily\\\": \\\"'JetBrains Mono', monospace\\\",\\n  \\\"rest-client.enableTelemetry\\\": false,\\n  \\\"docker.showStartPage\\\": false,\\n\\n  // --- GitLens (Lightweight) ---\\n  \\\"gitlens.currentLine.enabled\\\": true,\\n  \\\"gitlens.hovers.enabled\\\": false,\\n  \\\"gitlens.codeLens.enabled\\\": false,\\n\\n  // --- Visual & Eye-Care (Night Coding) ---\\n  \\\"editor.renderLineHighlight\\\": \\\"all\\\",\\n  \\\"editor.guides.indentation\\\": true,\\n  \\\"editor.colorDecorators\\\": true,\\n  \\\"errorLens.gutterIconsEnabled\\\": true,\\n  \\\"errorLens.followCursor\\\": \\\"allLines\\\",\\n  \\\"errorLens.scrollbarMarkersEnabled\\\": true,\\n  \\\"workbench.productIconTheme\\\": \\\"material-product-icons\\\",\\n  \\\"terminal.integrated.defaultProfile.windows\\\": \\\"Git Bash\\\",\\n  \\\"terminal.integrated.cursorStyle\\\": \\\"line\\\",\\n  \\\"git.autofetch\\\": true,\\n  \\\"gitlens.ai.model\\\": \\\"gitkraken\\\",\\n  \\\"gitlens.ai.gitkraken.model\\\": \\\"gemini:gemini-2.5-flash\\\",\\n}\\n\"}",
